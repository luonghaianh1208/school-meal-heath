rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Users collection — role-based access
    match /users/{userId} {
      // Any authenticated user can read their own profile
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // User can create their own profile on first login
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Only admin can update user profiles (e.g. change roles, assign classes)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Students collection — all authenticated users can read, admin can write
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Meal Records — all authenticated users can read/write
    match /mealRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Alerts — all authenticated can read, any authenticated can create
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
